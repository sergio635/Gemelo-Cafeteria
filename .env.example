# Copia este archivo a ".env" (en la raíz del proyecto) y rellena los valores
# de TU proyecto de Supabase. El archivo ".env" nunca se sube a Git.
#
# Los datos están en Supabase -> Project Settings -> API:
#   - Project URL  -> PUBLIC_SUPABASE_URL
#   - anon public key -> PUBLIC_SUPABASE_ANON_KEY

PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANONIMA